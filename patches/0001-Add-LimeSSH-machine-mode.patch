--- /dev/null
+++ b/host/internal/machine_exec_windows.go
@@ -0,0 +1,38 @@
+//go:build windows
+
+package internal
+
+import (
+	"os/exec"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+)
+
+func runMachineExec(cmd *exec.Cmd) error {
+	if err := cmd.Start(); err != nil {
+		return err
+	}
+
+	process, err := windows.OpenProcess(
+		windows.PROCESS_SET_QUOTA|windows.PROCESS_TERMINATE|windows.PROCESS_QUERY_INFORMATION,
+		false,
+		uint32(cmd.Process.Pid),
+	)
+	if err != nil {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		return err
+	}
+	defer windows.CloseHandle(process)
+
+	job, err := createJobObject(syscall.Handle(process))
+	if err != nil {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		return err
+	}
+	defer syscall.CloseHandle(job)
+
+	return cmd.Wait()
+}

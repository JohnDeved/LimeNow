+func (h *sessionHandler) handleMachineExec(sess gssh.Session) {
+	ctx, cancel := context.WithCancel(h.ctx)
+	defer cancel()
+
+	rawCommand := sess.RawCommand()
+	var cmd *exec.Cmd
+	if runtime.GOOS == "windows" {
+		cmd = exec.CommandContext(ctx, "cmd.exe", "/d", "/s", "/c", rawCommand)
+	} else {
+		cmd = exec.CommandContext(ctx, "/bin/sh", "-c", rawCommand)
+	}
+	cmd.Stdin = sess
+	cmd.Stdout = sess
+	cmd.Stderr = sess.Stderr()
+
+	err := runMachineExec(cmd)
+	if exitError, ok := err.(*exec.ExitError); ok {
+		_ = sess.Exit(exitError.ExitCode())
+		return
+	}
+	if err != nil {
+		h.logger.Error("machine-mode exec failed", "error", err)
+		_ = sess.Exit(1)
+		return
+	}
+	_ = sess.Exit(0)
+}
+
+func isLoopbackDestination(host string) bool {
+	host = strings.TrimSuffix(strings.ToLower(strings.TrimSpace(host)), ".")
+	if host == "localhost" {
+		return true
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}

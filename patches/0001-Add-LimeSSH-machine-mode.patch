+package internal
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"testing"
+)
+
+func TestIsLoopbackDestination(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		host string
+		want bool
+	}{
+		{name: "IPv4", host: "127.0.0.1", want: true},
+		{name: "IPv4 range", host: "127.42.0.9", want: true},
+		{name: "IPv6", host: "::1", want: true},
+		{name: "localhost", host: "localhost", want: true},
+		{name: "localhost case and dot", host: "LOCALHOST.", want: true},
+		{name: "unspecified IPv4", host: "0.0.0.0", want: false},
+		{name: "unspecified IPv6", host: "::", want: false},
+		{name: "private network", host: "192.168.1.1", want: false},
+		{name: "arbitrary hostname", host: "example.com", want: false},
+		{name: "localhost suffix", host: "localhost.example.com", want: false},
+	}
+
+	for _, tt := range tests {
+		tt := tt
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			if got := isLoopbackDestination(tt.host); got != tt.want {
+				t.Fatalf("isLoopbackDestination(%q) = %v, want %v", tt.host, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestMachineModeRequiresAuthorizedKey(t *testing.T) {
+	t.Parallel()
+
+	server := Server{
+		MachineMode:  true,
+		MachineShell: []string{"cmd.exe"},
+		Logger:       slog.New(slog.NewTextHandler(io.Discard, nil)),
+	}
+	err := server.ServeWithContext(context.Background(), nil)
+	if err == nil || err.Error() != "machine mode requires at least one authorized public key" {
+		t.Fatalf("ServeWithContext() error = %v", err)
+	}
+}
